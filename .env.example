# ====== Neon Postgres (Vercel Marketplace → Storage → Neon) ======
# Vercel auto-injects this when you connect a Neon database to the project.
# Use the POOLED connection string for serverless functions.
DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# ====== Clerk (https://dashboard.clerk.com) ======
# 1. Create an application in Clerk dashboard
# 2. Copy keys from "API Keys"
# 3. Add to Vercel: Settings → Environment Variables (Production + Preview + Development)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) Restrict who can sign up — set in Clerk → User & Authentication → Restrictions
